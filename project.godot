; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="Perplexity"
run/main_scene="uid://b4ws4gaic8rjp"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.78, 0.78, 0.78, 1)
boot_splash/image="uid://bonbny10ufgo2"

[audio]

buses/default_bus_layout="uid://wa130b6sd4re"
driver/output_latency.web=100

[autoload]

EventBus="*res://scripts/event_bus.gd"
Audio="*res://scenes/audio.tscn"
Config="*res://scripts/config.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/video_quality=1.0
movie_writer/movie_file="/home/tobias/Downloads/video.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[gui]

theme/custom="uid://dbqsov72nna8f"
theme/custom_font="uid://cvx1ij1c4enhk"

